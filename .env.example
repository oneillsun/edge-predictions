# Copy to .env and fill in. Never commit the real .env file.

# --- Kalshi ---
# No demo/sandbox is used in this project — these point at your real account
# and the production API. Through Milestone 7 the client only calls read-only
# (GET) endpoints; see CLAUDE_1.md for why that boundary matters here.
# Root domain only — the client appends /trade-api/v2 itself (that prefix is
# also part of what gets signed, per docs.kalshi.com).
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem
KALSHI_API_BASE_URL=https://external-api.kalshi.com
# Gates the Milestone 1 live smoke test (hits GET /markets on your real
# account — read-only, but still a real network call). Leave false normally.
KALSHI_LIVE_TEST_ENABLED=false

# --- Apify ---
APIFY_API_TOKEN=
# Actor used by the Milestone 3 news signal
APIFY_NEWS_ACTOR_ID=apify/website-content-crawler

# --- Polymarket (Milestone 3 cross-reference signal) ---
# Gamma API (public market/event metadata incl. prices) — not the CLOB
# order-book API, which lives at a different host and isn't what this signal
# needs.
POLYMARKET_API_BASE_URL=https://gamma-api.polymarket.com

# --- Database ---
DATABASE_URL=sqlite:///./app.db

# --- Alerting (pick what you wire up in Milestone 7) ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# --- Decision engine (Milestone 4) ---
# Minimum fee-adjusted edge required before a signal is flagged as tradeable.
EDGE_MARGIN_THRESHOLD=0.02

# --- Safety flags ---
# Hard-gates real order placement (Milestone 8). Must stay false until you
# have explicitly decided to go live.
LIVE_TRADING_ENABLED=false
MAX_POSITION_PCT_OF_BANKROLL=0.03
MAX_DAILY_LOSS_PCT_OF_BANKROLL=0.10
# Kelly is scaled by this factor before the hard cap above is applied (0.5 =
# half-Kelly). Milestone 4 never implements uncapped Kelly.
KELLY_FRACTION_CAP=0.5
# Starting simulated bankroll for Milestone 5's paper trading loop. Purely a
# bookkeeping number — never touches your real Kalshi balance.
PAPER_BANKROLL_USD=1000.0

# --- BTC 15-min scalp strategy (paper-simulated only, no real orders) ---
# Buys "Yes" at the start of each KXBTC15M window and closes at a profit
# target; a separate paper-money pool from PAPER_BANKROLL_USD above.
BTC_15MIN_POSITION_SIZE_USD=10.0
BTC_15MIN_PROFIT_TARGET_PCT=0.25
BTC_15MIN_POLL_SECONDS=5.0
# If more than this many seconds have passed since a window opened before we
# notice it, skip entering it entirely and wait for the next window rather
# than chasing a stale entry.
BTC_15MIN_ENTRY_WINDOW_SECONDS=60.0

# --- Frontend (Milestone 6) ---
VITE_API_BASE_URL=http://localhost:8000
