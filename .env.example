# Copy to .env and fill in. Never commit the real .env file.

# --- Kalshi ---
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private.pem
# Confirm the correct base URL for demo/sandbox vs. production on docs.kalshi.com
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_USE_DEMO=true

# --- Apify ---
APIFY_API_TOKEN=
# Actor used by the Milestone 3 news signal (e.g. website-content-crawler)
APIFY_NEWS_ACTOR_ID=

# --- Polymarket (Milestone 3 cross-reference signal) ---
POLYMARKET_API_BASE_URL=https://clob.polymarket.com

# --- Database ---
DATABASE_URL=sqlite:///./app.db

# --- Alerting (pick what you wire up in Milestone 7) ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# --- Decision engine (Milestone 4) ---
# Minimum fee-adjusted edge required before a signal is flagged as tradeable.
EDGE_MARGIN_THRESHOLD=0.02

# --- Safety flags ---
# Hard-gates real order placement (Milestone 8). Must stay false until you
# have explicitly decided to go live.
LIVE_TRADING_ENABLED=false
MAX_POSITION_PCT_OF_BANKROLL=0.03
MAX_DAILY_LOSS_PCT_OF_BANKROLL=0.10

# --- Frontend (Milestone 6) ---
VITE_API_BASE_URL=http://localhost:8000
